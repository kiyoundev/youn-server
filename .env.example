# Shared API key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change_me

# Pushover (https://pushover.net)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Gmail SMTP
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Stock data (optional fallback — leave blank to skip Finnhub)
FINNHUB_API_KEY=

# Frontend CORS origin
CORS_ORIGINS=http://localhost:3000

# Database (SQLite default; swap to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite
