# Shared API key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change_me

# Pushover (https://pushover.net)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Gmail SMTP
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Stock data (optional fallback — leave blank to skip Finnhub)
FINNHUB_API_KEY=

# TradingAgents — global defaults (same for every alert); per-alert overrides
# (deep_think_llm, quick_think_llm, anthropic_effort, max_debate_rounds,
# max_risk_discuss_rounds, analysts) are set via the API, not here
ANTHROPIC_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Frontend CORS origin
CORS_ORIGINS=http://localhost:3000

# Database — Postgres on Synology NAS (installed via DSM Package Center → PostgreSQL)
# Replace <nas-ip> with your NAS LAN IP, and set a strong password
DATABASE_URL=postgresql+asyncpg://youn:change_me@<nas-ip>:5433/youn_server

# Off the home LAN and NAS isn't reachable (no Tailscale yet)? Run Postgres
# locally instead: `docker compose -f docker-compose.local.yml up -d`, then
# swap DATABASE_URL to:
# DATABASE_URL=postgresql+asyncpg://youn:change_me@localhost:5433/youn_server

# Pi-hole admin web UI password (#34) — unrelated to the app above, shares
# only the host/compose file. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
PIHOLE_WEBPASSWORD=change_me
